# Firebase client SDK config (challenge-36b9e). Not secret by design (see
# Firebase docs), but kept out of version control to avoid per-developer
# project confusion. Copy this file to .env.local and fill in real values
# from `firebase apps:sdkconfig WEB <APP_ID> --project challenge-36b9e`.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to "true" to connect the app to the local Firebase Emulator Suite
# instead of the live challenge-36b9e project.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

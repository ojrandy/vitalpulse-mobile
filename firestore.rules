rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read/write only their own user document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default until a collection's rules are defined.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
